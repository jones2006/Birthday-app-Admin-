generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             String   @id @default(cuid())
  name           String
  registerNumber String   @unique
  dateOfBirth    DateTime
  whatsappNumber String
  academicYear   Int
  photo          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}